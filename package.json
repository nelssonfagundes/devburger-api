{
  "name": "devburger-api",
  "version": "1.0.0",
  "description": "API da hamburgueria DevBurger - DevClub Full Stack",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "sequelize db:migrate --config src/config/database.cjs --migrations-path src/database/migrations",
    "lint": "npx biome check --write .",
    "seed": "node src/database/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "stripe": "^17.4.0",
    "uuid": "^11.0.3",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "sequelize-cli": "^6.6.2"
  }
}
